// ---- Find artist inside user text ----
function getArtistFromInput($input, $artists) {
    $input = strtolower($input);
    foreach ($artists as $name => $data) {
        if (strpos($input, $name) !== false) {
            return $name;
        }
    }
    return null;
}

// ---- Handle user message ----
if (isset($_SERVER["REQUEST_METHOD"]) && $_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["message"])) {

    $userInput = trim($_POST["message"]);

    if ($userInput !== "") {

        // Store in chat history
        $_SESSION['chat'][] = ["sender" => "You", "message" => htmlspecialchars($userInput)];

        $lower = strtolower($userInput);
        $artist = getArtistFromInput($lower, $artists);

        // Decide bot response
        if ($artist === null) {
            $response = "I'm not familiar with that artist. Try one of these: Taylor Swift, Kendrick Lamar, Billie Eilish, Sleep Token, Tame Impala.";
        } else {
            $data = $artists[$artist];

            if (strpos($lower, "genre") !== false) {
                $response = ucfirst($artist) . " is known for: <strong>{$data['genre']}</strong>.";
            }
            elseif (strpos($lower, "album") !== false) {
                $response = ucfirst($artist) . " has <strong>{$data['albums']}</strong> album(s).";
            }
            elseif (strpos($lower, "popular song") !== false || strpos($lower, "biggest song") !== false) {
                $response = "The most popular song by " . ucfirst($artist) . " is <strong>{$data['popular_song']}</strong>.";
            }
            else {
                $response = "I understand the artist, but not the question. Try asking about genre, album count, or popular song.";
            }
        }

        // Save bot reply
        $_SESSION['chat'][] = ["sender" => "Bot", "message" => $response];
    }

    // Redirect to avoid form resubmission
    header("Location: " . $_SERVER['PHP_SELF']);
    exit;
}

